    <decisions>
        <description>Si ya hay una cita (no cancelada) en la misma fecha y hora, vuelve al paso 3 con un aviso.</description>
        <name>Hay_Cita_Mismo_Horario</name>
        <label>¿Horario ocupado?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Crear_Nueva_Cita</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Horario libre</defaultConnectorLabel>
        <rules>
            <name>Horario_Ocupado</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Buscar_Cita_Mismo_Horario</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Obtener_Cliente_Conflicto</targetReference>
            </connector>
            <label>Horario ocupado</label>
        </rules>
    </decisions>
    <description>Screen Flow guiado para crear una nueva cita en 3 pasos: cliente, servicios, y fecha/hora/pago. Si el horario ya está ocupado o el guardado falla, vuelve al paso 3 con un aviso.</description>
    <dynamicChoiceSets>
        <name>Clientes_Disponibles</name>
        <dataType>String</dataType>
        <displayField>Full_Name__c</displayField>
        <object>Salon_Client__c</object>
        <sortField>Full_Name__c</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Servicios_Disponibles</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Salon_Service__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Name</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>DetalleError</name>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) &gt; 0, IF(FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) &gt; FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}), MID({!$Flow.FaultMessage}, FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12, FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) - FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) - 11), MID({!$Flow.FaultMessage}, FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12, 1000)), {!$Flow.FaultMessage})</expression>
    </formulas>
    <formulas>
        <name>MensajeConflicto</name>
        <dataType>String</dataType>
        <expression>&quot;Ya hay una cita agendada para ese día y horario&quot; &amp; IF(ISBLANK({!Obtener_Cliente_Conflicto.Full_Name__c}), &quot;&quot;, &quot; (&quot; &amp; {!Obtener_Cliente_Conflicto.Full_Name__c} &amp; &quot;)&quot;) &amp; &quot;. Elegí otro horario o cancelá esa cita antes de continuar.&quot;</expression>
    </formulas>
    <formulas>
        <name>MensajeErrorGuardado</name>
        <dataType>String</dataType>
        <expression>&quot;No se pudo crear la cita: &quot; &amp; {!DetalleError}</expression>
    </formulas>
    <interviewLabel>Flujo_Nueva_Cita {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Nueva Cita — Asistente de Reserva</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <description>Crea el registro de la nueva cita.</description>
        <name>Crear_Nueva_Cita</name>
        <label>Crear Nueva Cita</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Asignar_Error_Guardado</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Appointment_Date__c</field>
            <value>
                <elementReference>Campo_FechaHora</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Client__c</field>
            <value>
                <elementReference>Campo_Cliente</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>Campo_Notas</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Method__c</field>
            <value>
                <elementReference>Campo_MetodoPago</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Services__c</field>
            <value>
                <elementReference>Campo_Servicios</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Programada</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Amount__c</field>
            <value>
                <elementReference>Campo_Monto</elementReference>
            </value>
        </inputAssignments>
        <object>Salon_Appointment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>Busca una cita no cancelada en exactamente la misma fecha y hora (misma regla que el flujo Cita_Verificar_Conflicto).</description>
        <name>Buscar_Cita_Mismo_Horario</name>
        <label>Buscar Cita en el Mismo Horario</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Hay_Cita_Mismo_Horario</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Asignar_Error_Guardado</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Appointment_Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Campo_FechaHora</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelada</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Salon_Appointment__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Client__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Obtiene el nombre del cliente de la cita existente para mostrarlo en el aviso.</description>
        <name>Obtener_Cliente_Conflicto</name>
        <label>Obtener Cliente de la Cita Existente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Asignar_Error_Conflicto</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Asignar_Error_Conflicto</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Buscar_Cita_Mismo_Horario.Client__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Salon_Client__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Full_Name__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
