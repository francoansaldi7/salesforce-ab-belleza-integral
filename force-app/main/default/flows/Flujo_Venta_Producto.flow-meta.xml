<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Asignar_Error_Guardado</name>
        <label>Asignar Mensaje de Error al Guardar</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>MensajeError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MensajeErrorGuardado</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Pantalla_Venta</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>VP_Efectivo</name>
        <choiceText>Efectivo</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Efectivo</stringValue>
        </value>
    </choices>
    <choices>
        <name>VP_Tarjeta</name>
        <choiceText>Tarjeta</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Tarjeta</stringValue>
        </value>
    </choices>
    <choices>
        <name>VP_Transferencia</name>
        <choiceText>Transferencia</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Transferencia</stringValue>
        </value>
    </choices>
    <decisions>
        <description>Verifica que la cantidad solicitada no supere el stock disponible.</description>
        <name>Verificar_Stock</name>
        <label>¿Hay stock suficiente?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Stock_Insuficiente</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Stock insuficiente</defaultConnectorLabel>
        <rules>
            <name>Stock_Suficiente</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Venta_Cantidad</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Obtener_Producto.Stock_Quantity__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Crear_Transaccion_Venta</targetReference>
            </connector>
            <label>Stock suficiente</label>
        </rules>
    </decisions>
    <description>Screen Flow para registrar la venta de un producto al cliente: selecciona producto, ingresa cantidad, descuenta el stock y crea la transacción de ingreso.</description>
    <dynamicChoiceSets>
        <name>Productos_Disponibles</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>Salon_Product__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>DescripcionVenta</name>
        <dataType>String</dataType>
        <expression>&quot;Venta de &quot; &amp; TEXT({!Venta_Cantidad}) &amp; &quot; x &quot; &amp; {!Obtener_Producto.Name}</expression>
    </formulas>
    <formulas>
        <name>Hoy</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>MensajeErrorStock</name>
        <dataType>String</dataType>
        <expression>&quot;No es posible registrar esta venta. El stock disponible de &apos;&quot; &amp; {!Obtener_Producto.Name} &amp; &quot;&apos; es de &quot; &amp; TEXT({!Obtener_Producto.Stock_Quantity__c}) &amp; &quot; unidades, pero se solicitaron &quot; &amp; TEXT({!Venta_Cantidad}) &amp; &quot; unidades. Por favor, ajustá la cantidad e intentá de nuevo.&quot;</expression>
    </formulas>
    <formulas>
        <name>MontoVenta</name>
        <dataType>Currency</dataType>
        <expression>({!Obtener_Producto.Sale_Price__c} - {!Obtener_Producto.Cost_Price__c}) * {!Venta_Cantidad}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>NuevoStock</name>
        <dataType>Number</dataType>
        <expression>{!Obtener_Producto.Stock_Quantity__c} - {!Venta_Cantidad}</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>DetalleError</name>
        <dataType>String</dataType>
        <expression>IF(FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) &gt; 0, IF(FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) &gt; FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}), MID({!$Flow.FaultMessage}, FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12, FIND(&quot;. You can look up&quot;, {!$Flow.FaultMessage}) - FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) - 11), MID({!$Flow.FaultMessage}, FIND(&quot;_EXCEPTION: &quot;, {!$Flow.FaultMessage}) + 12, 1000)), {!$Flow.FaultMessage})</expression>
    </formulas>
    <formulas>
        <name>MensajeErrorGuardado</name>
        <dataType>String</dataType>
        <expression>&quot;No se pudo registrar la venta: &quot; &amp; {!DetalleError}</expression>
    </formulas>
    <interviewLabel>Flujo_Venta_Producto {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Vender Producto</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Crear_Transaccion_Venta</name>
        <label>Crear Transacción de Venta</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Actualizar_Stock</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Deshacer_Venta</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Amount__c</field>
            <value>
                <elementReference>MontoVenta</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Category__c</field>
            <value>
                <stringValue>Venta de Producto</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description__c</field>
            <value>
                <elementReference>DescripcionVenta</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Method__c</field>
            <value>
                <elementReference>Venta_MetodoPago</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Related_Appointment__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Related_Product__c</field>
            <value>
                <elementReference>Venta_ProductoId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transaction_Date__c</field>
            <value>
                <elementReference>Hoy</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Transaction_Type__c</field>
            <value>
                <stringValue>Ingreso</stringValue>
            </value>
        </inputAssignments>
        <object>Salon_Transaction__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Obtener_Producto</name>
        <label>Obtener Datos del Producto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Verificar_Stock</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Asignar_Error_Guardado</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Venta_ProductoId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Salon_Product__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Sale_Price__c</queriedFields>
        <queriedFields>Cost_Price__c</queriedFields>
        <queriedFields>Stock_Quantity__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordRollbacks>
        <description>Si falla la transacción o el descuento de stock, deshace ambos para que nunca quede una venta sin descontar stock (o al revés).</description>
        <name>Deshacer_Venta</name>
        <label>Deshacer Venta</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Asignar_Error_Guardado</targetReference>
        </connector>
    </recordRollbacks>
    <recordUpdates>
        <name>Actualizar_Stock</name>
        <label>Descontar Stock del Producto</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Deshacer_Venta</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Venta_ProductoId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Stock_Quantity__c</field>
            <value>
                <elementReference>NuevoStock</elementReference>
            </value>
        </inputAssignments>
        <object>Salon_Product__c</object>
    </recordUpdates>
    <screens>
        <description>Muestra un error cuando la cantidad solicitada supera el stock disponible.</description>
        <name>Error_Stock_Insuficiente</name>
        <label>Stock insuficiente</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>false</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Icono</name>
            <fieldText>&lt;p style=&quot;text-align:center;font-size:2rem;&quot;&gt;⚠️&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
